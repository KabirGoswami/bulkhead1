# ==============================================================================
# Bulkhead Backend Environment Configuration
# ==============================================================================
# Copy this file to `backend/.env` for local backend development.

# ------------------------------------------------------------------------------
# 1. CORE & DEV CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'true' to allow HTTP on localhost and enable the one-click Dev Login.
# Set to 'false' in production (requires HTTPS).
BULKHEAD_DEV_LOCALHOST=true

# Must match the frontend origin exactly (no trailing slash).
# Vite default is http://localhost:8080 (or http://localhost:5173).
BULKHEAD_ORIGIN=http://localhost:8080

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite (Zero external setup, recommended for local dev):
BULKHEAD_DATABASE_URL=sqlite:///bulkhead.db

# Supabase Managed PostgreSQL (Use Session Pooler port 5432 or direct host):
# BULKHEAD_DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Local / Docker PostgreSQL:
# BULKHEAD_DATABASE_URL=postgresql+psycopg://bulkhead:bulkhead-local@localhost:5432/bulkhead

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 CONFIGURATION
# ------------------------------------------------------------------------------
# Steps to obtain credentials:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Application type: "Web application").
# 3. Add to "Authorized JavaScript origins":
#    http://localhost:8080
# 4. Add to "Authorized redirect URIs":
#    http://localhost:8080/api/v1/auth/google/callback
# 5. Paste the Client ID and Secret below:
BULKHEAD_GOOGLE_CLIENT_ID=
BULKHEAD_GOOGLE_CLIENT_SECRET=

# Alternative: path to file containing client secret (used in container secrets):
# BULKHEAD_GOOGLE_CLIENT_SECRET_FILE=

# ------------------------------------------------------------------------------
# 4. EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Option A: Resend API (Recommended - sends real emails via https://resend.com)
# Provide your Resend API key (re_...).
# Note: For free accounts without custom domains, 'onboarding@resend.dev' is used automatically.
# When you verify a custom domain on Resend, update BULKHEAD_SMTP_SENDER to your domain.
BULKHEAD_RESEND_API_KEY=

# Option B: Local SMTP Mock (Mailpit):
# Used automatically if BULKHEAD_RESEND_API_KEY is left empty.
BULKHEAD_SMTP_HOST=localhost
BULKHEAD_SMTP_PORT=1025
BULKHEAD_SMTP_SENDER=Bulkhead <security@bulkhead.local>


# ------------------------------------------------------------------------------
# 5. NIST NVD API (Vulnerability Advisories)
# ------------------------------------------------------------------------------
# Optional: NIST National Vulnerability Database API Key (https://nvd.nist.gov/developers/request-an-api-key)
# Without a key, requests are limited to 5 calls/30s. With a key, limit is 50 calls/30s.
BULKHEAD_NVD_API_KEY=

# ------------------------------------------------------------------------------
# 6. HARDWARE / GATEWAY SIMULATION
# ------------------------------------------------------------------------------
# Keep false for local simulation (set to true only for physical OpenWRT router agent)
BULKHEAD_ADAPTER_ENABLED=false
BULKHEAD_DRY_RUN=true
