# Copy to .env; keep this deployment on loopback for the initial lab.
POSTGRES_PASSWORD=bulkhead-local
BULKHEAD_ORIGIN=http://localhost:8080
BULKHEAD_DEV_LOCALHOST=true
BULKHEAD_ADAPTER_ENABLED=false
BULKHEAD_DRY_RUN=true
BULKHEAD_SMTP_HOST=mailpit
BULKHEAD_SMTP_PORT=1025
BULKHEAD_GOOGLE_CLIENT_ID=
BULKHEAD_GOOGLE_CLIENT_SECRET=
# Secure alternative: mount a secret file and set this path in the container.
# BULKHEAD_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret
