import React, { useState, useEffect, useCallback, useRef } from 'react';
import { ReactFlow, Background, Controls, Handle, Position, Node, NodeProps, Edge, ReactFlowInstance, ReactFlowProvider, useNodesState, useEdgesState, MarkerType } from 'reactflow';
import { Camera, Laptop, Lightbulb, Lock, Network, Plug, Radio, Router, ShieldCheck, Smartphone, Speaker, Target, Thermometer, X, type LucideIcon } from 'lucide-react';
import 'reactflow/dist/style.css';
import '../styles/home-map.css';
import '../styles/workspace.css';
import { api, errorText } from '../lib/api';
import { useBulkhead } from '../lib/session';

interface NetworkNodeData {
  label: string;
  kind: 'device' | 'account';
  deviceType?: string;
  zone?: string;
  linkedCount?: number;
  status?: 'normal' | 'source' | 'reachable';
}

const deviceIcons: Record<string, LucideIcon> = {
  router: Router, hub: Radio, camera: Camera, lock: Lock, thermostat: Thermometer,
  speaker: Speaker, plug: Plug, bulb: Lightbulb, phone: Smartphone, laptop: Laptop,
};

function NetworkNode({ data }: NodeProps<NetworkNodeData>) {
  const Icon = data.kind === 'account' ? ShieldCheck : deviceIcons[data.deviceType || ''] || Network;
  return (
    <div className={`topology-node ${data.status === 'source' ? 'selected' : data.status === 'reachable' ? 'flagged-node' : ''}`} data-status={data.status || 'normal'}>
      <Handle type="target" position={Position.Top} className="network-node-handle" />
      <span className="node-kicker">{data.kind === 'account' ? 'IDENTITY' : 'DEVICE'}</span>
      <strong>{data.label}</strong>
      <span>{data.kind === 'account' ? `${data.linkedCount} linked devices` : `${data.deviceType} · ${data.zone}`}</span>
      <Handle type="source" position={Position.Bottom} className="network-node-handle" />
    </div>
  );
}

const nodeTypes = { network: NetworkNode };

export default function HomeMap() {
  const [nodes, setNodes] = useNodesState<NetworkNodeData>([]);
  const [edges, setEdges] = useEdgesState([]);
  const [selectedNode, setSelectedNode] = useState<string | null>(null);
  const [blastRadius, setBlastRadius] = useState<string[]>([]);
  const [flow, setFlow] = useState<ReactFlowInstance<NetworkNodeData> | null>(null);
  const canvasRef = useRef<HTMLDivElement>(null);

  const { state, path, error: stateError } = useBulkhead();
  const [analysisError, setAnalysisError] = useState('');
  const [analysisLoading, setAnalysisLoading] = useState(false);

  useEffect(() => {
    if (!state) return;
    const newNodes: Node<NetworkNodeData>[] = [
      ...state.devices.map((device: any, index: number) => ({
        id: device.id, type: 'network',
        data: { label: device.name, kind: 'device' as const, deviceType: device.type,
          zone: `${device.zone}${device.isolated ? ' · contained' : ''}` },
        position: { x: (index % 4) * 250, y: 140 + Math.floor(index / 4) * 150 },
      })),
      ...state.accounts.map((account: any, index: number) => ({
        id: account.id, type: 'network', data: { label: `${account.name}${account.access_revoked ? ' · revoked' : ''}`,
          kind: 'account' as const, linkedCount: account.access_revoked ? 0 : account.linked_device_ids.length },
        position: { x: 100 + (index % 2) * 450, y: Math.floor(index / 2) * -120 },
      })),
    ];
    const newEdges: Edge[] = state.edges.map((edge: any, index: number) => ({
      id: `${edge.source}-${edge.target}-${index}`, source: edge.source, target: edge.target,
      type: 'smoothstep', label: edge.kind === 'account' ? 'account access' : edge.kind === 'peer' ? 'allowed peer' : undefined,
      markerEnd: { type: MarkerType.ArrowClosed, color: 'currentColor', width: 14, height: 14 },
      className: edge.kind === 'account' ? 'network-account-edge' : 'network-zone-edge',
      style: { stroke: edge.kind === 'account' ? 'var(--accent)' : 'var(--muted)', strokeWidth: 1, opacity: edge.kind === 'account' ? 0.65 : 0.3 },
      labelStyle: { fill: 'var(--accent)', fontSize: 9 },
      labelBgStyle: { fill: 'var(--bg)' },
    }));
    setNodes(newNodes); setEdges(newEdges);
  }, [state, setNodes, setEdges]);

  useEffect(() => {
    setBlastRadius([]); setAnalysisError('');
    if (!selectedNode) return;
    const controller = new AbortController();
    setAnalysisLoading(true);
    api(path(`/blast/${selectedNode}`), { signal: controller.signal })
      .then(response => { if (!controller.signal.aborted) setBlastRadius(response.reachable); })
      .catch(err => { if (!controller.signal.aborted) setAnalysisError(errorText(err)); })
      .finally(() => { if (!controller.signal.aborted) setAnalysisLoading(false); });
    return () => controller.abort();
  }, [selectedNode, path, state?.sequence]);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!flow || !canvas || nodes.length === 0) return;
    let frame = 0;
    const refit = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => flow.fitView({ padding: 0.13, minZoom: 0.2, maxZoom: 1 }));
    };
    const observer = new ResizeObserver(refit);
    observer.observe(canvas);
    refit();
    return () => { observer.disconnect(); cancelAnimationFrame(frame); };
  }, [flow, nodes.length]);

  const onNodeClick = (_event: React.MouseEvent, node: Node) => setSelectedNode(node.id);

  useEffect(() => {
    setNodes(current => current.map(node => ({
      ...node, data: { ...node.data, status: node.id === selectedNode ? 'source' : blastRadius.includes(node.id) ? 'reachable' : 'normal' },
    })));
  }, [selectedNode, blastRadius, state, setNodes]);

  const selectedLabel = nodes.find(node => node.id === selectedNode)?.data.label;

  return (
    <ReactFlowProvider>
    <div className="network-layout">
      {stateError && <p role="alert" className="app-error">Map unavailable: {stateError}</p>}
      {!state && !stateError && <p role="status">Loading the household map…</p>}
      <div className="topology-shell">
        <div className="topology-caption">
          <Network size={14}/><span> {nodes.length - blastRadius.length} connected · {blastRadius.length} affected</span>
          <span className="toolbar-divider" />
          <span className="capture-label">SNAPSHOT · {state?.sequence || 0} sequence</span>
        </div>
        <div className="topology-canvas" ref={canvasRef}>
          <ReactFlow
            nodes={nodes} edges={edges} nodeTypes={nodeTypes}
            onInit={instance => setFlow(instance)}
            onNodesChange={() => {}} onEdgesChange={() => {}} onNodeClick={onNodeClick}
            fitView fitViewOptions={{ padding: 0.13, maxZoom: 1 }} minZoom={0.2} maxZoom={2}
          >
            <Background color="var(--border)" gap={28} size={1} />
            <Controls showInteractive={false} />
          </ReactFlow>
        </div>
        <div className="topology-legend">
          <span><i className="map-legend-device" /> Device</span>
          <span><i className="map-legend-account" /> Account</span>
          <span><i className="map-legend-link" /> Linked access</span>
        </div>
      </div>
      {selectedNode && (
        <div className="network-inspector" aria-live="polite">
          <div className="workspace-heading">
            <div><span className="eyebrow">DEVICE INSPECTOR</span><h2 id="network-title">Node Analysis</h2></div>
            <button type="button" className="map-analysis-close" onClick={() => { setSelectedNode(null); setBlastRadius([]); }} aria-label="Clear Selection" title="Clear Selection"><X size={15} /></button>
          </div>
          <strong className="inspector-address">{selectedLabel}</strong>
          <span className="inspector-state">{selectedNode}</span>
          <div className="traffic-detail">
            <span className="severity">Blast radius</span>
            <h3>{analysisLoading ? "Loading…" : analysisError ? "Unavailable" : `${blastRadius.length} nodes affected`}</h3>
            {analysisError && <p role="alert" className="app-error">{analysisError}</p>}
            <div className="traffic-volume">
              <span>CAPTURE RANGE</span>
              <strong>{blastRadius.length}</strong>
              <div className="traffic-volume-track"><span style={{ width: `${(blastRadius.length / (nodes.length || 1)) * 100}%` }} /></div>
              <small>Affected share of total household topology</small>
            </div>
          </div>
          <div className="topology-legend">
            <span><i className="map-key-source" /> Selected source</span>
            <span><i className="map-key-reachable" /> Reachable</span>
          </div>
        </div>
      )}
    </div>
    </ReactFlowProvider>
  );
}
